# Server Bootstrap Configuration
# Only system-level bootstrap variables live here.
# All user-level credentials (SMTP, Groq AI key, etc.) are entered via the in-app Settings UI and encrypted at rest.

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/careermail_pro

# Security & Secrets
JWT_SECRET=super_secret_jwt_access_token_key_change_in_production_32chars!
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_32chars!
# 32 bytes in hex (64 chars) for AES-256-GCM settings encryption
ENCRYPTION_KEY=f6a8e32c813bbd74d39fae6189ef9490351f08cb38b939dc6158f447604ad473

# URLs and Ports
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5000
